# .terraformignore - files to exclude from Terraform operations

# Git files
.git/
.gitignore

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Documentation
README.md
*.md
docs/

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Terraform state (should not be uploaded)
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Sensitive files
*.pem
*.key
secrets/
credentials/

